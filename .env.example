# ---- Zendesk Knowledge MCP (read-only) -------------------------------------
# All settings are optional. No credentials are required for the public
# documentation, changelog, or status endpoints.

# Identify this client to Zendesk (be a good citizen; include a contact).
ZD_USER_AGENT="zendesk-knowledge-mcp/1.0 (+https://github.com/nightious/zendesk-knowledge-mcp)"

# Default Help Center locale (e.g. en-us, de, fr, ja, pt-br).
ZD_DEFAULT_LOCALE=en-us

# HTTP behaviour
ZD_HTTP_TIMEOUT_MS=15000
ZD_HTTP_MAX_RETRIES=2
# Per-host requests per minute (status.zendesk.com is capped at 10 by Zendesk).
ZD_RATE_SUPPORT_PER_MIN=60
ZD_RATE_DEVELOPER_PER_MIN=60
ZD_RATE_STATUS_PER_MIN=10

# Short-lived in-memory cache (seconds). Nothing is written to disk.
ZD_CACHE_TTL_SEARCH_S=300
ZD_CACHE_TTL_PAGE_S=900
ZD_CACHE_TTL_STATUS_S=60
ZD_CACHE_TTL_SITEMAP_S=3600
ZD_CACHE_MAX_ENTRIES=500

# Maximum characters of cleaned article/page content returned per item.
ZD_MAX_CONTENT_CHARS=12000

# Log level: silent | error | info | debug  (logs go to stderr, never stdout)
ZD_LOG_LEVEL=info

# ---- Future authenticated integrations (NOT used by this server) ----------
# If you later build the separate, permission-controlled admin server, use
# OAuth and keep secrets out of source control. Never put tokens in code.
# ZD_OAUTH_CLIENT_ID=
# ZD_OAUTH_REDIRECT_URI=
# ZD_OAUTH_SCOPES="read"
