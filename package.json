{
  "name": "zendesk-knowledge-mcp",
  "version": "1.0.1",
  "description": "Read-only MCP server that answers Zendesk questions from live official Zendesk sources (support.zendesk.com, developer.zendesk.com, status.zendesk.com).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "nightious",
  "homepage": "https://github.com/nightious/zendesk-knowledge-mcp",
  "repository": { "type": "git", "url": "git+https://github.com/nightious/zendesk-knowledge-mcp.git" },
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "claude", "claude-code", "codex", "zendesk", "help-center", "documentation"],
  "bin": { "zendesk-knowledge-mcp": "dist/index.mjs" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=bundle --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/node": "^20.14.0",
    "cheerio": "^1.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.8"
  }
}
